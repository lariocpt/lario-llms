# User systemd service for RTX 5080 models
# Enable: systemctl --user enable --now rtx5080@qwen38
# Switch: systemctl --user stop rtx5080@vision && systemctl --user start rtx5080@qwen38

[Unit]
Description=RTX 5080 Model: %i
After=graphical-session.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
Environment=CUDA_VISIBLE_DEVICES=0
Environment=PATH=/home/lario/.venv/rtx5080/bin:/usr/bin:/bin

# Vision model (Qwen2.5-VL-3B)
ExecStartPre=/bin/bash -c 'if [[ "%i" == "vision" ]]; then systemctl --user stop rtx5080@qwen38 rtx5080@flux rtx5080@sdxl 2>/dev/null || true; fi'
ExecStartPre=/bin/bash -c 'if [[ "%i" == "qwen38" ]]; then systemctl --user stop rtx5080@vision rtx5080@flux rtx5080@sdxl 2>/dev/null || true; fi'
ExecStartPre=/bin/bash -c 'if [[ "%i" == "flux" ]]; then systemctl --user stop rtx5080@vision rtx5080@qwen38 rtx5080@sdxl 2>/dev/null || true; fi'
ExecStartPre=/bin/bash -c 'if [[ "%i" == "sdxl" ]]; then systemctl --user stop rtx5080@vision rtx5080@qwen38 rtx5080@flux 2>/dev/null || true; fi'
ExecStartPre=/bin/sleep 3

ExecStart=/bin/bash -c '
  case "%i" in
    vision)
      exec python -m sglang.launch_server \
        --model-path Qwen/Qwen2.5-VL-3B-Instruct \
        --port 8080 \
        --mem-fraction-static 0.9 \
        --max-total-tokens 32768 \
        --chunked-prefill-size 8192
      ;;
    qwen38)
      exec python -m sglang.launch_server \
        --model-path unsloth/Qwen3.8-27B-NVFP4 \
        --port 30000 \
        --mem-fraction-static 0.95 \
        --max-total-tokens 262144 \
        --chunked-prefill-size 16384 \
        --kv-cache-dtype fp8 \
        --page-size 16
      ;;
    flux)
      exec python -m flux_api \
        --model black-forest-labs/FLUX.1-dev \
        --port 8188 \
        --device cuda \
        --offload-cpu False \
        --vae-slicing True \
        --attention-slicing True
      ;;
    sdxl)
      exec python -m sdxl_api \
        --model stabilityai/stable-diffusion-xl-base-1.0 \
        --port 8189 \
        --device cuda \
        --offload-cpu False \
        --vae-slicing True \
        --attention-slicing True
      ;;
  esac
'

Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target