#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
nvidia-smi --query-gpu=name,driver_version,memory.total,memory.used --format=csv
systemctl --user status rtx5080.service --no-pager
"$ROOT/rtx5080/rtx5080" list
"$ROOT/rtx5080/rtx5080" show
"$ROOT/rtx5080/rtx5080" budget
python3 "$ROOT/rtx5080/monitor.py"
