#!/usr/bin/env bash
# rtx5080 - GPU model service manager for RTX 5080
# Usage: rtx5080 {vision|qwen38|stop|status|logs|switch}

set -euo pipefail

# ─── Config ──────────────────────────────────────────────────────
CONFIG_DIR="${HOME}/.config/rtx5080"
LOG_DIR="${HOME}/.local/share/rtx5080/logs"
PID_DIR="${HOME}/.local/share/rtx5080/pids"
mkdir -p "${CONFIG_DIR}" "${LOG_DIR}" "${PID_DIR}"

# Model configurations
declare -A MODELS=(
  [vision]="Qwen2.5-VL-3B-Instruct"
  [qwen38]="Qwen3.8-27B-GGUF-Q3_K_XL"
  [flux]="FLUX.1-dev"
  [sdxl]="SDXL 1.0"
)

declare -A MODEL_PATHS=(
  [vision]="Qwen/Qwen2.5-VL-3B-Instruct"
  [qwen38]="unsloth/Qwen3.8-27B-GGUF"
  [flux]="black-forest-labs/FLUX.1-dev"
  [sdxl]="stabilityai/stable-diffusion-xl-base-1.0"
)

declare -A GGUF_FILES=(
  [qwen38]="Qwen3.8-27B-UD-Q3_K_XL.gguf"
)

declare -A MM_PROJ_FILES=(
  [vision]="mmproj-Qwen2.5-VL-3B-Instruct-f16.gguf"
  [qwen38]="mmproj-F16.gguf"
)

declare -A PORTS=(
  [vision]=8081
  [qwen38]=30000
  [flux]=8188
  [sdxl]=8189
)

# llama.cpp server binary (CUDA-enabled build)
LLAMA_SERVER="${HOME}/build/llama.cpp/build/bin/llama-server"

# ─── Helpers ─────────────────────────────────────────────────────
log() { echo "[$(date '+%H:%M:%S')] $*" | tee -a "${LOG_DIR}/rtx5080.log"; }
err() { echo "[$(date '+%H:%M:%S')] ERROR: $*" >&2 | tee -a "${LOG_DIR}/rtx5080.log"; }

get_pid() { [[ -f "${PID_DIR}/${1}.pid" ]] && cat "${PID_DIR}/${1}.pid" || echo ""; }
is_running() { local pid=$(get_pid "$1"); [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; }

wait_gpu_free() {
  local timeout=30
  while [[ $timeout -gt 0 ]]; do
    local used=$(nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits -i 0 | awk '{print $1}')
    [[ $used -lt 500 ]] && return 0
    sleep 1
    ((timeout--))
  done
  err "GPU memory not freed after 30s (used: ${used}MB)"
  return 1
}

kill_model() {
  local name=$1
  local pid=$(get_pid "$name")
  if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
    log "Stopping $name (PID: $pid)..."
    kill -TERM "$pid" 2>/dev/null
    local t=10
    while [[ $t -gt 0 ]] && kill -0 "$pid" 2>/dev/null; do sleep 0.5; ((t--)); done
    kill -KILL "$pid" 2>/dev/null || true
    rm -f "${PID_DIR}/${name}.pid"
    log "Stopped $name"
  fi
}

# ─── Commands ────────────────────────────────────────────────────
cmd_start() {
  local model=$1
  [[ -z "${MODEL_PATHS[$model]:-}" ]] && { err "Unknown model: $model"; return 1; }

  if is_running "$model"; then
    log "$model already running (PID: $(get_pid "$model"))"
    return 0
  fi

  # Stop any other running model
  for m in "${!MODELS[@]}"; do
    [[ "$m" != "$model" ]] && is_running "$m" && kill_model "$m"
  done
  wait_gpu_free

  local port=${PORTS[$model]}
  local path=${MODEL_PATHS[$model]}
  local cache_dir="${HOME}/.cache/huggingface/hub"

  log "Starting $model (${MODELS[$model]}) on port $port..."

  case $model in
    vision)
      # Use llama.cpp for vision (ggml-org repo)
      local repo_dir="${cache_dir}/models--ggml-org--Qwen2.5-VL-3B-Instruct-GGUF"
      
      model_file=""
      for f in "$repo_dir"/Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf; do
        [[ -f "$f" ]] && model_file="$f" && break
      done
      
      mmproj_file=""
      for f in "$repo_dir"/mmproj-Qwen2.5-VL-3B-Instruct-f16.gguf; do
        [[ -f "$f" ]] && mmproj_file="$f" && break
      done
      
      if [[ ! -f "$model_file" ]]; then
        log "Downloading vision model..."
        ~/.venv/rtx5080/bin/hf download ggml-org/Qwen2.5-VL-3B-Instruct-GGUF --local-dir "$repo_dir" --include "*Q4_K_M*" --include "*mmproj*f16*"
        for f in "$repo_dir"/Qwen2.5-VL-3B-Instruct-Q4_K_M.gguf; do
          [[ -f "$f" ]] && model_file="$f" && break
        done
        for f in "$repo_dir"/mmproj-Qwen2.5-VL-3B-Instruct-f16.gguf; do
          [[ -f "$f" ]] && mmproj_file="$f" && break
        done
      fi

      if [[ ! -f "$model_file" ]]; then
        err "Vision model file not found"
        return 1
      fi

      log "Using model: $model_file"
      log "Using mmproj: $mmproj_file"

      nohup "$LLAMA_SERVER" -m "$model_file" --mmproj "$mmproj_file" -ngl 99 -c 32768 --port "$port" --host 0.0.0.0 \
        --flash-attn auto --parallel 1 \
        >> "${LOG_DIR}/${model}.log" 2>&1 &
      ;;
    qwen38)
      local repo_dir="${cache_dir}/models--unsloth--Qwen3.8-27B-GGUF"
      
      # Look in main dir first (where files actually are), then snapshots
      # Q3_K_XL first (13GB fits on 16GB), then Q4_0 (15GB too large)
      model_file=""
      for f in "$repo_dir"/Qwen3.8-27B-UD-Q3_K_XL.gguf "$repo_dir"/Qwen3.8-27B-Q4_0.gguf; do
        [[ -f "$f" ]] && model_file="$f" && break
      done
      if [[ -z "$model_file" ]]; then
        for f in "$repo_dir"/snapshots/*/Qwen3.8-27B-UD-Q3_K_XL.gguf "$repo_dir"/snapshots/*/Qwen3.8-27B-Q4_0.gguf; do
          [[ -f "$f" ]] && model_file="$f" && break
        done
      fi
      
      mmproj_file=""
      for f in "$repo_dir"/mmproj-F16.gguf; do
        [[ -f "$f" ]] && mmproj_file="$f" && break
      done
      if [[ -z "$mmproj_file" ]]; then
        for f in "$repo_dir"/snapshots/*/mmproj-F16.gguf; do
          [[ -f "$f" ]] && mmproj_file="$f" && break
        done
      fi
      
      if [[ ! -f "$model_file" ]]; then
        log "Downloading qwen38 model (Q3_K_XL)..."
        ~/.venv/rtx5080/bin/hf download unsloth/Qwen3.8-27B-GGUF --local-dir "$repo_dir" --include "*UD-Q3_K_XL*" --include "*mmproj-F16*"
        for f in "$repo_dir"/Qwen3.8-27B-UD-Q3_K_XL.gguf "$repo_dir"/Qwen3.8-27B-Q4_0.gguf; do
          [[ -f "$f" ]] && model_file="$f" && break
        done
        if [[ -z "$model_file" ]]; then
          for f in "$repo_dir"/snapshots/*/Qwen3.8-27B-UD-Q3_K_XL.gguf "$repo_dir"/snapshots/*/Qwen3.8-27B-Q4_0.gguf; do
            [[ -f "$f" ]] && model_file="$f" && break
          done
        fi
        for f in "$repo_dir"/mmproj-F16.gguf; do
          [[ -f "$f" ]] && mmproj_file="$f" && break
        done
        if [[ -z "$mmproj_file" ]]; then
          for f in "$repo_dir"/snapshots/*/mmproj-F16.gguf; do
            [[ -f "$f" ]] && mmproj_file="$f" && break
          done
        fi
      fi

      if [[ ! -f "$model_file" ]]; then
        err "Model file not found"
        return 1
      fi

      log "Using model: $model_file"
      log "Using mmproj: $mmproj_file"

      # 32k context with Q3_K_XL (13GB model) on 16GB VRAM
      nohup "$LLAMA_SERVER" -m "$model_file" --mmproj "$mmproj_file" -ngl 99 -c 32768 --port "$port" --host 0.0.0.0 \
        --flash-attn auto --parallel 1 \
        >> "${LOG_DIR}/${model}.log" 2>&1 &
      ;;
    flux)
      err "FLUX not yet implemented with llama.cpp"
      return 1
      ;;
    sdxl)
      err "SDXL not yet implemented with llama.cpp"
      return 1
      ;;
  esac

  local pid=$!
  echo $pid > "${PID_DIR}/${model}.pid"

  # Wait for server ready
  local t=120
  while [[ $t -gt 0 ]]; do
    if curl -sf "http://localhost:${port}/health" >/dev/null 2>&1; then
      log "$model ready at http://localhost:${port}"
      return 0
    fi
    sleep 1
    ((t--))
  done

  err "$model failed to start (check ${LOG_DIR}/${model}.log)"
  kill_model "$model"
  return 1
}

cmd_stop() {
  local model=${1:-}
  if [[ -n "$model" ]]; then
    kill_model "$model"
  else
    for m in "${!MODELS[@]}"; do kill_model "$m"; done
  fi
  wait_gpu_free
}

cmd_status() {
  echo "=== RTX 5080 Model Status ==="
  nvidia-smi --query-gpu=name,memory.total,memory.used,memory.free,utilization.gpu --format=csv,noheader -i 0 | \
    awk -F', ' '{printf "GPU: %s | VRAM: %s/%s | Util: %s%%\n", $1, $3, $2, $5}'

  echo ""
  for m in "${!MODELS[@]}"; do
    local status="STOPPED"
    local pid=$(get_pid "$m")
    local port=${PORTS[$m]}
    if is_running "$m"; then
      status="RUNNING (PID: $pid, port: $port)"
      curl -sf "http://localhost:${port}/health" >/dev/null 2>&1 && status+=" ✓ healthy" || status+=" ✗ unhealthy"
    fi
    printf "%-8s %-30s %s\n" "$m" "${MODELS[$m]}" "$status"
  done
}

cmd_logs() {
  local model=${1:-}
  if [[ -n "$model" ]]; then
    [[ -f "${LOG_DIR}/${model}.log" ]] && tail -f "${LOG_DIR}/${model}.log" || err "No logs for $model"
  else
    tail -f "${LOG_DIR}"/*.log 2>/dev/null || err "No logs found"
  fi
}

cmd_switch() {
  local target=$1
  [[ -z "${MODEL_PATHS[$target]:-}" ]] && { err "Unknown model: $target. Use: vision or qwen38"; return 1; }
  log "Switching to $target..."
  cmd_stop
  cmd_start "$target"
}

cmd_bench() {
  local model=${1:-qwen38}
  local port=${PORTS[$model]}
  local prompt="Write a detailed explanation of how transformers work in 500 words."

  log "Benchmarking $model on port $port..."
  local start=$(date +%s.%N)
  curl -s "http://localhost:${port}/generate" \
    -H "Content-Type: application/json" \
    -d "{\"text\":\"$prompt\",\"sampling_params\":{\"max_new_tokens\":512,\"temperature\":0.7}}" > /dev/null
  local end=$(date +%s.%N)
  local elapsed=$(echo "$end - $start" | bc)
  log "Time: ${elapsed}s"
}

# ─── Main ────────────────────────────────────────────────────────
case "${1:-}" in
  vision)    cmd_start vision ;;
  qwen38)    cmd_start qwen38 ;;
  stop)      cmd_stop "${2:-}" ;;
  status)    cmd_status ;;
  logs)      cmd_logs "${2:-}" ;;
  switch)    cmd_switch "${2:-}" ;;
  bench)     cmd_bench "${2:-qwen38}" ;;
  *)
    cat <<EOF
Usage: rtx5080 <command> [args]

Commands:
  vision           Start Qwen2.5-VL-3B vision model (port 8080)
  qwen38           Start Qwen3.8-27B-NVFP4 (port 30000)
  flux             Start FLUX.1-dev (port 8188)
  sdxl             Start SDXL 1.0 (port 8189)
  switch <model>   Switch to model (vision|qwen38|flux|sdxl) - stops other first
  stop [model]     Stop model or all models
  status           Show GPU + model status
  logs [model]     Follow logs (all or specific)
  bench [model]    Quick generation benchmark

Models:
  vision  - Qwen2.5-VL-3B-Instruct (vision + text, ~8GB VRAM)
  qwen38  - Qwen3.8-27B-NVFP4 (text + vision, ~14.5GB VRAM)
  flux    - FLUX.1-dev (image gen, ~12GB VRAM)
  sdxl    - SDXL 1.0 (image gen, ~8GB VRAM)

Examples:
  rtx5080 vision          # Start vision model
  rtx5080 qwen38          # Start Qwen 3.8 27B
  rtx5080 flux            # Start FLUX.1-dev
  rtx5080 sdxl            # Start SDXL 1.0
  rtx5080 switch qwen38   # Switch from vision → qwen38
  rtx5080 status          # Check what's running
  rtx5080 logs qwen38     # Follow qwen38 logs
EOF
    exit 1
    ;;
esac