[Unit]
Description=Run the agents' model backend check every 5 minutes
Documentation=file:///home/lario/Projects/personal/lario-llms/scripts/agent-llm-monitor.sh

[Timer]
# 5 min matches vision-monitor.timer, and for the same reason: the frequent checks here are
# the free ones — the log scan and /running — while the completion probe is rate-limited
# independently inside the script. Tightening this does not increase GPU cost.
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
