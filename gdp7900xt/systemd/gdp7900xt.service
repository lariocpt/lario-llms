[Unit]
Description=gdp 7900xt optional eGPU backend (identity guarded)
After=network-online.target
RequiresMountsFor=/mnt/xfs/AI_Models

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
EnvironmentFile=%h/.config/lario-admission/gdp7900xt.env
ExecCondition=/usr/bin/python3 %h/Projects/personal/lario-llms/shared/boot_ready.py gdp7900xt
ExecCondition=/usr/bin/python3 %h/Projects/personal/lario-llms/gdp7900xt/runtime.py check
ExecStart=/usr/bin/python3 %h/Projects/personal/lario-llms/gdp7900xt/runtime.py run
TimeoutStartSec=1860
TimeoutStopSec=60
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
