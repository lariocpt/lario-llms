[Unit]
Description=RX 7900 XT M.2-slot model backend (rootless ROCm)
After=network-online.target
RequiresMountsFor=/mnt/AI_Models

[Service]
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
EnvironmentFile=%h/.config/lario-admission/geekom7900xt.env
ExecCondition=/usr/bin/python3 %h/Projects/personal/lario-llms/shared/boot_ready.py geekom7900xt
ExecCondition=/usr/bin/python3 %h/Projects/personal/lario-llms/geekom7900xt/runtime.py check
ExecStartPre=/usr/bin/python3 %h/Projects/personal/lario-llms/shared/serving/configure.py geekom7900xt
ExecStart=/usr/bin/python3 %h/Projects/personal/lario-llms/geekom7900xt/runtime.py run
TimeoutStartSec=1860
TimeoutStopSec=60
Restart=on-failure
RestartSec=15

[Install]
WantedBy=default.target
