// ai.in.drlario.org — OpenCode provider config for the whole inference fleet.
//
// Mint a key and a ready copy of this file for a machine:
//     ssh bigcachy ai-gateway add <machine>
// which fills @AI_GATE_KEY@ (and @MACHINE_NAME@ below) with real values, or
// regenerate later with `ssh bigcachy ai-gateway config <machine>`.
//
// To wire a machine up by hand: replace @AI_GATE_KEY@ with the key from
// `ai-gateway add`, then merge the provider blocks below into
// ~/.config/opencode/opencode.jsonc — opencode merges provider blocks, it does
// not replace the file.
//
// Auth: every request needs Authorization: Bearer <key>; the gateway is
// fail-closed (no key, bad key or revoked key -> 401). Each prefix maps to one
// hardware backend, so fixed-profile IDs keep their meaning and busy hardware
// still refuses. See lario-home-infra caddy/Caddyfile and bin/ai-gateway.
//
// The mcp block wires the remote lario MCPs on mcp.in.drlario.org (lario-mcps
// serve.py on big-cachy, same keyring). Machines listed in its policy get
// these without a local lario-mcps checkout; a machine's own local stdio
// entries override same-named remote ones when merged by hand. See
// lario-mcps/REMOTE.md.
//
// minted-for: @MACHINE_NAME@
{
  "provider": {
    "geekom": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "geekom hardware models",
      "options": {
        "baseURL": "https://ai.in.drlario.org/geekom/v1",
        "apiKey": "@AI_GATE_KEY@"
      },
      "models": {
        "geekom.qwen38-flash-halogen.c262144.kf16-vf16.s4.halogen-256k.2be8caa2bd": {
          "name": "gkm-256k shared-qw3.8 FN Halogen HGN-v2-4.16bpw K:f16/V:f16",
          "tool_call": true,
          "limit": {
            "context": 258048,
            "output": 32768
          },
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "attachment": true
        },
        "geekom.qwen38-flash-halogen-128k.c131072.kf16-vf16.s4.halogen-128k.f42df48f91": {
          "name": "gkm-128k shared-qw3.8 FN Halogen HGN-v2-4.16bpw K:f16/V:f16",
