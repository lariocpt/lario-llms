  "mcp": {
    "servers": {
      "lario_models": {
        "type": "remote",
        "url": "https://mcp.in.drlario.org/mcp/models",
        "oauth": false,
        "codemode": false,
        "headers": { "Authorization": "Bearer @AI_GATE_KEY@" },
        "timeout": { "startup": 30000, "catalog": 30000, "execution": 120000 }
      },
      "lario_intel": {
        "type": "remote",
        "url": "https://mcp.in.drlario.org/mcp/intel",
        "oauth": false,
