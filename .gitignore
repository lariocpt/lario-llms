# Ignore ALL Bifrost runtime data including config.db. config.db is a live-mutating SQLite
# DB — tracking it caused a branch-switch to revert it mid-WAL and crash Bifrost with
# "database disk image is malformed". The provider config it holds (ollama -> http://ollama:11434,
# network_config.allow_private_network=true) is documented in fedora-llms/04-bifrost-routing-security.md.
bifrost/

# Ignore generated images and temporary script outputs
ml_env/scripts/*.png
ml_env/scripts/*.jpg
ml_env/scripts/*.wav

# Ignore Python cache
__pycache__/
*.pyc

# ChromaDB vector data
chroma-data/

# Dev container build artifacts
dev-containers/*.tar.gz
dev-containers/yazi
dev-containers/gram
dev-containers/.opencode/
dev-containers/splashboard
dev-containers/.splashboard/secrets.toml
dev-containers/.harlequin.toml




# Python virtualenvs
.venv/
**/.venv/

# llama-swap config is GENERATED by main-model.sh (source of truth); state file too
llama-cpp/config.yaml
.main-model
# same for the XT's agent-llm: GENERATED by agent-model.sh (bigcachy only)
llama-cpp/agent-config.yaml
.agent-model
.rtx5080-model
.geekom.lock
.geekom7900xt.lock
.rtx5080.lock
.deployment-holds.json
.*-selection.json
rtx5080/config/generated.yaml
.env

# Python virtual environment
.venv/

intel/research/*.npy

.arcB70-model
.arcB70-selection.json
llama-cpp/arcB70-config.yaml

.arcB70.lock

# Generated by rtx3060ti/runtime.py
rtx3060ti/config/generated.yaml

# Generated canonical Radeon backend and private local selection
llama-cpp/geekom7900xt-config.yaml
.geekom7900xt-selection.json
.geekom7900xt-model

# Local RTX 3060 Ti selection and workload lock
.rtx3060ti-model
.rtx3060ti.lock

# Retired laptop GPU runtime lock
.7900xt.lock
