EMBEDDING_DEVICE=CPU
EMBEDDING_MODEL_DIR=/mnt/xfs/AI_Models/openvino/embeddings/bge-m3-fp16
ASR_DEVICE=NPU
ASR_MODEL_DIR=/mnt/xfs/AI_Models/openvino/asr/whisper-large-v3-turbo-fp16
TRANSLATION_DEVICE=GPU.0
# Pin the existing Arrow Lake iGPU; adding Arc must not move translation onto it.
TRANSLATION_DEVICE_UUID=8680677d060000000002000000000000
TRANSLATION_MODEL_DIR=/mnt/xfs/AI_Models/openvino/translation/qwen3-8b-int4
TTS_DEVICE=CPU
TTS_MODEL_DIR=/mnt/xfs/AI_Models/openvino/tts/kokoro-82m-int8
# The RAG container reaches the embedding service through Docker's host gateway.
BIND_HOST=0.0.0.0
