# Copy to .env (gitignored). Compose reads this automatically.
# Bifrost tailnet exposure: set to this box's tailscale IP (tailscale ip -4).
# Leave unset/loopback if tailscale isn't up — the admin API has no auth.
BIFROST_BIND_IP=127.0.0.1

# ─── agent-llm (bigcachy only: Muse Glimmer on the RX 7900 XT) ───
# COMPOSE_PROFILES=xt enables the profile-gated agent-llm service — set it only on the
# box with the card; without it, compose skips the service (and its /dev/kfd bind).
#COMPOSE_PROFILES=xt
# Render node of the Navi 31. DRM nodes RENUMBER when a card is added — re-derive after
# any PCI change, never assume:
#   ls -l /dev/dri/by-path/ | grep "$(lspci -D | awk '/Navi 31/{print $1}')"
#XT_RENDER_NODE=/dev/dri/renderD129
# agent-llm exposure beyond loopback (keyless API — LAN/tailnet only, never WAN).
# Unset vars fall back to distinct 127.0.0.x addresses in the compose file so nothing
# is exposed by default. bigcachy values: direct-cable end 192.168.2.2 (for l-dev-ai),
# LAN 192.168.10.241, tailnet 100.127.91.5 (mini-mobile roaming).
#AGENT_LLM_BIND_DIRECT=192.168.2.2
#AGENT_LLM_BIND_LAN=192.168.10.241
#AGENT_LLM_BIND_TS=100.127.91.5
